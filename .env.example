# AuditForge environment template — placeholders only; never commit real values.
# Public browser variables must contain no secrets.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY

# Server-only; include only if this runtime actually requires it.
SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_SERVER_ONLY_SECRET

# FastAPI
APP_ENV=development
APP_NAME=AuditForge API
API_V1_PREFIX=/api/v1
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO
REQUEST_ID_HEADER=X-Request-ID

# Supabase/PostgreSQL — select the documented connection method at implementation.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY
SUPABASE_JWT_ISSUER=https://YOUR_PROJECT.supabase.co/auth/v1
SUPABASE_JWT_SECRET=REPLACE_WITH_SUPABASE_JWT_SECRET_OR_PUBLIC_KEY
SUPABASE_JWT_AUDIENCE=authenticated
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require


# Private storage buckets and upload limits
EVIDENCE_BUCKET=auditforge-evidence
REPORTS_BUCKET=auditforge-reports
SIGNED_URL_TTL_SECONDS=300
MAX_UPLOAD_BYTES=20971520
MAX_PDF_PAGES=100
MAX_IMAGE_PIXELS=40000000

# AI provider; server-side only; configure only if implemented
GOOGLE_GEMINI_API_KEY=REPLACE_WITH_SERVER_ONLY_SECRET
GEMINI_MODEL_ID=CONFIGURE_SUPPORTED_MODEL_ID
AI_REQUEST_TIMEOUT_SECONDS=60
AI_MAX_RETRIES=3
AI_MAX_INPUT_BYTES=15000000

# OCR/background processing
OCR_PROVIDER=paddleocr
OCR_LANGUAGE=en
PDF_TEXT_EXTRACTION_ENABLED=true
PROCESSING_WORKER_ENABLED=true
JOB_POLL_INTERVAL_SECONDS=2
JOB_MAX_ATTEMPTS=4
JOB_LEASE_SECONDS=180

# Optional queue; leave blank when database-backed worker is used
REDIS_URL=
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

# Rate limits; use shared production-grade limiter for multi-instance deployments
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=120
UPLOAD_RATE_LIMIT_PER_HOUR=30
AI_RATE_LIMIT_PER_HOUR=30

# Observability; do not log secrets/document contents
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=

# Testing only; never point destructive tests at production
TEST_DATABASE_URL=
E2E_BASE_URL=http://localhost:3000
E2E_API_URL=http://localhost:8000/api/v1
