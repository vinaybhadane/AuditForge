{
  "name": "auditforge",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --prefix apps/web",
    "build:web": "npm run build --prefix apps/web",
    "lint:web": "npm run lint --prefix apps/web",
    "typecheck:web": "npm run typecheck --prefix apps/web",
    "test:web": "npm run typecheck:web",
    "dev:api": "powershell -Command \"Set-Location apps/api; uvicorn app.main:app --reload --port 8000\"",
    "test:api": "powershell -Command \"Set-Location apps/api; pytest\""
  }
}
